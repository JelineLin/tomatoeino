[Unit]
Description=Generate today's English Coach lesson
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermas
Group=hermas
WorkingDirectory=/opt/englishcoach
EnvironmentFile=/opt/englishcoach/.env
Environment=ENGLISH_DB_PATH=/var/lib/englishcoach/learning.db
Environment=ENGLISH_AUDIO_DIR=/var/lib/englishcoach/audio
ExecStart=/opt/englishcoach/server generate-today
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/englishcoach
